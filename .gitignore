# Python / virtual environments
__pycache__/
*.py[cod]
*$py.class
*.pyc
instance/
venv/
.venv/
env/
.eggs/
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Secrets
.env

# Transient SQLite lock/backup files (never ignore primary .db files!)
*.db-shm
*.db-wal
*.db.pre-restore*
tormentnexus.db.pre-restore

# Raw stdout log streams (structured JSON/JSONL logs in logs/ remain tracked)
*.log

# Node dependencies & compiled local Go executables (binaries remain on disk, not purged)
/node_modules/
/backend/*.exe
/backend/api
